# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.env.*
!.env.example

# Local agent configuration
/.claude/settings.local.json

# Jupyter
.ipynb_checkpoints/

# Data / results
data/raw/*
data/processed/*
results/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!results/.gitkeep
!results/README.md

# Retained local research payloads
#
# These paths contain external downloads, evidence caches, generated review
# payloads, or historical non-human annotation attempts.  Their small control
# files (README/manifest) may be force-tracked; the remaining local payload is
# bound by docs/repository_hygiene/retained_local_payloads.sha256.tsv.
/data/evidence_cache/
/data/external/
/data/annotations/ai_adjudicated_gold/
/data/annotations/expert_candidate/
/data/annotations/holdout/
/data/annotations/phase_d/
/data/annotations/rq2/consistency_review/
/data/annotations/rq2/cwe_taxonomy_impact_human_review/
/data/annotations/rq2/reference_normalization_impact_human_review/
/data/annotations/rq2/discrepancy_typing_seed.csv
/data/annotations/rq2/discrepancy_typing_seed.jsonl
/data/annotations/rq3/

# Local literature sources and historical paper builds
/docs/related_work_papers/**/*.pdf
/paper/cose/**/*.pdf

# Logs
*.log

# LaTeX / paper builds
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv
